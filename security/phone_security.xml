<odoo>
    <record id="module_category_phone" model="ir.module.category">
        <field name="name">Phone</field>
        <field name="description">Browser-based SIP telephony.</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_phone" model="res.groups.privilege">
        <field name="name">Webphone</field>
        <field name="description">Manage SIP accounts and global telephony configuration.</field>
        <field name="category_id" ref="module_category_phone"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_phone_manager" model="res.groups">
        <field name="name">Phone Manager</field>
        <field name="comment">Manage SIP accounts and global telephony configuration.</field>
        <field name="privilege_id" ref="privilege_phone"/>
    </record>
</odoo>
